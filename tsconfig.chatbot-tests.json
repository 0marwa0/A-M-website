{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp/chatbot-tests",
    "types": ["node"]
  },
  "include": ["lib/chatbot/**/*.ts", "scripts/test-chatbot-conversations.ts"]
}

